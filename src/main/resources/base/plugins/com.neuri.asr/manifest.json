{
  "schema_version": "1",
  "id": "com.neuri.asr",
  "name": "Voice Recognition Plugin",
  "version": "1.0.0",
  "entrypoint": "plugin:VoicePlugin",
  "permissions": [
    "nav.navigate",
    "storage.read",
    "storage.write",
    "speech.model.load",
    "speech.recognize"
  ],

  "api_compatibility": {
    "min": "1.0.0",
    "max": "1.x.x"
  },
  "dependencies": {
    "python": [
      { "package": "vosk" },
      { "package": "pyaudio" },
      { "package": "wave" }
    ]
  }
}
